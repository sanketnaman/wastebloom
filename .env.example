# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# If unset, AI endpoints report enabled:false and the scanner shows honest
# "not configured" messaging (sample items and guides keep working).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WasteBloom AI Configuration (see src/server/aiConfig.ts)
AI_ENABLED=true
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.8-flash"
AI_VISION_MODEL="gemini-3.8-flash"
AI_MAX_IMAGE_SIZE_MB=8
AI_JSON_LIMIT="16mb"
AI_TIMEOUT_MS=30000

# Per-IP rate limits for /api/ai/* (sliding window, in-memory)
AI_RATE_WINDOW_MS=60000
AI_RATE_MAX=15
AI_DAILY_LIMIT=200

# Newsletter: POST endpoint that receives { email, source } as JSON.
# When unset, POST /api/newsletter/subscribe answers configured:false and the
# UI shows an honest "not configured" message instead of pretending to succeed.
NEWSLETTER_WEBHOOK_URL=""
NEWSLETTER_RATE_WINDOW_MS=60000
NEWSLETTER_RATE_MAX=5

# Set to "true" when running behind a reverse proxy so per-IP rate limiting
# uses X-Forwarded-For instead of the proxy's socket address.
TRUST_PROXY=false

# Server port (defaults to 3000)
PORT=3000
